# Blender 5.1.1 MTL File: 'lab440.blend'
# www.blender.org

newmtl cables
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
illum 2
map_Kd C:/cables_BaseColor.png
map_Ns C:/cables_Roughness.png
map_refl C:/cables_Metallic.png
map_d C:/cables_Alpha.png
map_Bump -bm 1.000000 C:/cables_Normal.png

